<Window x:Class="UchetPropuskov.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отчёты" Height="400" Width="600" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="10">
        <TextBlock Text="Начало периода:" Margin="0,0,0,2"/>
        <DatePicker x:Name="dpStart" Margin="0,0,0,5"/>

        <TextBlock Text="Конец периода:" Margin="0,0,0,2"/>
        <DatePicker x:Name="dpEnd" Margin="0,0,0,10"/>

        <Button Content="Сформировать отчёт" Click="GenerateReport_Click" Margin="0,0,0,10"/>
        <DataGrid x:Name="dgReport" AutoGenerateColumns="True" Height="300"/>
    </StackPanel>
</Window>
