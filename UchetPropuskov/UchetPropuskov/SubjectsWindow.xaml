<Window x:Class="UchetPropuskov.SubjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Предметы" Height="300" Width="300" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="10">
        <TextBox x:Name="tbSubject" Text="Название предмета" Margin="0,0,0,10"/>
        <Button Content="Добавить предмет" Click="AddSubject_Click" Margin="0,0,0,10"/>
        <ListBox x:Name="lbSubjects" Height="200"/>
    </StackPanel>
</Window>
