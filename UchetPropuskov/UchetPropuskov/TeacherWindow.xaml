<Window x:Class="UchetPropuskov.TeacherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Преподаватель"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <!-- Верхняя панель -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">

            <TextBlock Text="Группа:" VerticalAlignment="Center"/>
            <ComboBox x:Name="cbGroups" Width="150" Margin="5"
                      DisplayMemberPath="Название"
                      SelectedValuePath="ГруппаID"
                      SelectionChanged="FilterChanged"/>

            <TextBlock Text="Предмет:" VerticalAlignment="Center"/>
            <ComboBox x:Name="cbSubjects" Width="200" Margin="5"
                      DisplayMemberPath="Название"
                      SelectedValuePath="ПредметID"
                      SelectionChanged="FilterChanged"/>

            <TextBlock Text="Дата:" VerticalAlignment="Center"/>
            <DatePicker x:Name="dpDate"
            SelectedDateChanged="DateChanged"
            Width="130" Margin="5"/>
            <Button Content="Сохранить"
        Width="120"
        Margin="10,0"
        Click="Save_Click"/>
            <Button Content="Отчёт" Click="Report_Click" Margin="20,0"/>
        </StackPanel>

        <DataGrid x:Name="dgJournal"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  MouseDoubleClick="dgJournal_MouseDoubleClick">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" Binding="{Binding ФИО}" Width="*"/>
                <DataGridTextColumn Header="1" Binding="{Binding P1}" Width="40"/>
                <DataGridTextColumn Header="2" Binding="{Binding P2}" Width="40"/>
                <DataGridTextColumn Header="3" Binding="{Binding P3}" Width="40"/>
                <DataGridTextColumn Header="4" Binding="{Binding P4}" Width="40"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
