<Window x:Class="UchetPropuskov.UsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пользователи" Height="350" Width="350" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="10">
        <TextBox x:Name="tbFio" Text="ФИО" Margin="0,0,0,5"/>
        <TextBox x:Name="tbLogin" Text="Логин" Margin="0,0,0,5"/>
        <PasswordBox x:Name="tbPass" Margin="0,0,0,5"/>
        <ComboBox x:Name="cbRole" Margin="0,0,0,10">
            <ComboBoxItem Content="Администратор"/>
            <ComboBoxItem Content="Преподаватель"/>
        </ComboBox>
        <Button Content="Создать пользователя" Click="CreateUser_Click" Margin="0,0,0,10"/>
        <ListBox x:Name="lbUsers" Height="180"/>
    </StackPanel>
</Window>
